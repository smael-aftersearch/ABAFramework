{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Authority": "",
    "Audience": "",
    "AllowHttpMetadataInDevelopment": false
  },
  "Api": {
    "Cors": {
      "AllowedOrigins": []
    }
  },
  "AllowedHosts": "*",
  "Platform": {
    "Database": {
      "Provider": "None"
    },
    "Cache": {
      "Provider": "Memory",
      "DistributedCoordination": {
        "Enabled": false,
        "Namespace": "",
        "MaxConcurrentSourceLoads": 32,
        "MaxSourceLoadsPerWindow": 300,
        "SourceLoadWindowSeconds": 60,
        "AcquireTimeoutSeconds": 10,
        "LeaseDurationSeconds": 30
      }
    },
    "Messaging": {
      "Enabled": false,
      "Transport": "Local",
      "AutoProvisionInDevelopment": false,
      "Kafka": {
        "SecurityProtocol": "Plaintext",
        "SaslMechanism": "",
        "SaslUsername": "",
        "SaslPassword": ""
      }
    },
    "Observability": {
      "Enabled": false,
      "ServiceName": "Aba.Starter.Api",
      "OtlpEndpoint": ""
    },
    "Tenancy": {
      "Enabled": false,
      "ClaimType": "tenant_id"
    },
    "RateLimit": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "Shared": {
        "Enabled": false,
        "Namespace": ""
      }
    }
  },
  "ConnectionStrings": {
    "AbaDatabase": "",
    "AbaRedis": "",
    "AbaRabbitMQ": "",
    "AbaKafka": ""
  }
}
